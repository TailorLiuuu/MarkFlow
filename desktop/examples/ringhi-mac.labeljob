{
  "format": "label-production",
  "version": 1,
  "name": "RingHi · 像素品牌标签",
  "template": {
    "format": "label-desk",
    "version": 1,
    "id": "ringhi-pixel-compact-30x20",
    "name": "RingHi · 紧凑像素标签",
    "width": 30,
    "height": 20,
    "elements": [
      {
        "id": "name",
        "type": "text",
        "x": 0.5,
        "y": 0.85,
        "w": 29,
        "h": 3.3,
        "font": 2.6,
        "bold": true,
        "align": "center",
        "content": "RingHi_{{mac_last4}}"
      },
      {
        "id": "qr",
        "type": "qr",
        "x": 1.7,
        "y": 3.1,
        "w": 14,
        "h": 14,
        "content": "{{mac}}"
      },
      {
        "id": "logo",
        "type": "image",
        "x": 16.545,
        "y": 5.655,
        "w": 8.89,
        "h": 8.89,
        "crop_white": true,
        "image_png": ""
      },
      {
        "id": "mac",
        "type": "text",
        "x": 0.5,
        "y": 16.3,
        "w": 29,
        "h": 3.0,
        "font": 2.25,
        "bold": true,
        "align": "center",
        "content": "{{mac}}"
      }
    ]
  },
  "workflow": {
    "variables": {
      "model": "ESP32",
      "batch": ""
    },
    "steps": [
      {
        "id": "source",
        "type": "read_esp32_mac"
      },
      {
        "id": "format",
        "type": "format_id",
        "case": "upper",
        "separator": "compact",
        "prefix": ""
      },
      {
        "id": "preview",
        "type": "preview"
      },
      {
        "id": "print",
        "type": "print_label"
      }
    ]
  }
}